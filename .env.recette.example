# Modele de la pile de RECETTE (scripts/recette/up.sh). Les @JETONS@ sont remplaces par des
# secrets aleatoires dans .recette/.env.recette (git-ignore). Ne jamais utiliser en production.
COMPOSE_PROJECT_NAME=onea-recette
# Secrets de la recette : fichiers generes par scripts/generer-secrets.sh (hors de ce fichier).
ONEA_SECRETS_DIR=@SECRETS_DIR@
PUBLIC_HOST=audit.recette.test
SSO_HOST=sso.recette.test
TLS_CERT_DIR=@TLS_CERT_DIR@
SSO_CA_BUNDLE_PATH=/etc/onea/ca/recette-ca.pem
ADMIN_ALLOW_CIDR=
APP_VERSION=recette
DJANGO_ADMIN_ENABLED=false
EMAIL_URL=smtp://mailpit:1025
POSTGRES_DB=onea
POSTGRES_USER=onea
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=@KC_ADMIN_PASSWORD@
KEYCLOAK_DB_PASSWORD=@KC_DB_PASSWORD@
KEYCLOAK_ADMIN_API_CLIENT_ID=onea-admin-sync
DOCUMENTS_HOST_DIR=@DOCUMENTS_HOST_DIR@
