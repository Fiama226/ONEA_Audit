# PRODUCTION environment file. Copy to .env.prod (git-ignored) and replace EVERY CHANGE_ME.
#   docker compose --env-file .env.prod -f docker/compose.prod.yml config -q
# Placeholders only - no real secret belongs in this file. See docs/deploy.md.
#
# SECRETS ARE NOT IN THIS FILE (lot 9, T17): they are files generated by scripts/generer-secrets.sh
# in ONEA_SECRETS_DIR (SECRET_KEY, PostgreSQL passwords, Redis, OIDC client, Keycloak sync account,
# Meilisearch, metrics token, SMTP password). The only secrets kept here are the two Keycloak ones
# below, because Keycloak cannot read a secret file.

# --- Secret files: directory owned by root, mode 0700 (sh scripts/generer-secrets.sh) ---
ONEA_SECRETS_DIR=/etc/onea/secrets

# --- Public host names (DNS must point to this server; the TLS certificate must cover both) ---
PUBLIC_HOST=audit.example.org
SSO_HOST=sso.example.org
# Host directory holding fullchain.pem and privkey.pem (mounted read-only into nginx)
TLS_CERT_DIR=/etc/onea/certs
# Webroot of the ACME http-01 challenge (Let's Encrypt route only; mounted read-only into nginx)
ACME_WEBROOT=/var/www/onea-acme
# Addresses (comma-separated IPs/CIDRs) allowed to open the Keycloak admin console and the
# master realm through nginx. Empty = nobody (use an SSH tunnel instead, see docs/deploy.md).
ADMIN_ALLOW_CIDR=
# Only if the SSO certificate is signed by an internal CA: path INSIDE the container of a PEM
# bundle placed in ./certs/ (e.g. /etc/onea/ca/ca-bundle.pem). Empty = default trust store.
SSO_CA_BUNDLE_PATH=

# --- Réseau interne "web" (nginx <-> web/worker) ---
# Sous-réseau fixe et adresse fixe de nginx : seule adresse de confiance pour web/gunicorn
# (TRUSTED_PROXY_CIDRS et FORWARDED_ALLOW_IPS en dérivent). L'adresse doit appartenir au sous-réseau.
ONEA_SUBNET_WEB=172.30.10.0/28
ONEA_NGINX_IP=172.30.10.2
# Plage dynamique Docker du reseau web : DANS le sous-reseau, sans contenir ONEA_NGINX_IP.
ONEA_IP_RANGE_WEB=172.30.10.8/29
# Verifier l'absence de chevauchement avec les reseaux existants : docker network inspect
# Répartiteurs / proxys placés DEVANT nginx (CIDR, séparés par des virgules) dont l'en-tête
# X-Forwarded-For est cru pour déterminer l'adresse du client. Vide = désactivé (défaut).
TRUSTED_UPSTREAM_CIDRS=

# --- Release: tag of the application images (onea-backend / onea-frontend) ---
APP_VERSION=1.0.0

# --- Django ---
# Django /admin/ stays off unless set to true
DJANGO_ADMIN_ENABLED=false
# Outgoing mail (SMTP relay of the organisation)
# smtp+tls:// = STARTTLS (587), smtps:// = implicit TLS (465), smtp:// = plain (internal relay)
# WITHOUT the password: it goes in the secret file $ONEA_SECRETS_DIR/email_password (worker only).
EMAIL_URL=smtp+tls://user@smtp.example.org:587

# --- PostgreSQL (application) ---
POSTGRES_DB=onea
POSTGRES_USER=onea
# Application role (web, worker, beat): created at the first start of an empty database volume;
# for an existing database see docs/deploy.md ("Base de données"). Must differ from POSTGRES_USER.
# Passwords: secret files postgres_password (owner) and postgres_app_password (application role).
POSTGRES_APP_USER=onea_app
# --- Keycloak (own PostgreSQL instance) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_password
# Secrets of the realm clients are secret files too (oidc_client_secret for onea-backend,
# keycloak_sync_secret for the service account onea-admin-sync): docs/deploy.md, sections 3 and 5.
KEYCLOAK_ADMIN_API_CLIENT_ID=onea-admin-sync

# --- Documents (fichiers générés) : disque du serveur, voir docs/stockage-fichiers.md ---
# Dossier de l'hôte monté dans web et worker (créé par : install -d -o 10001 -g 10001 -m 0750 ...).
DOCUMENTS_HOST_DIR=/srv/onea/documents

# --- Optional tuning ---
# COMPOSE_PROJECT_NAME=onea-prod
# WEB_CONCURRENCY=3

# Limites de debit par utilisateur (surcharge facultative, forme N/sec|min|hour|day)
# THROTTLE_RATE_GENERATION=20/min
# THROTTLE_RATE_APERCU=30/min
# THROTTLE_RATE_TELEVERSEMENT=30/hour
# THROTTLE_RATE_IMPORT=10/hour
# THROTTLE_RATE_EXPORT=30/min
# THROTTLE_RATE_ANONYME=30/min
# THROTTLE_RATE_ANNUAIRE=60/min
# THROTTLE_RATE_RECHERCHE=60/min

# --- Antivirus ClamAV (SEC-04) : conteneur separe `clamav`, analyse de TOUT televersement ---
# `clamav` par defaut. `aucun` est refuse en production sauf ANTIVIRUS_AUTORISER_AUCUN=true.
ANTIVIRUS_MOTEUR=clamav
# true = clamd injoignable => televersement refuse (503). false = accepte sans analyse (a eviter).
ANTIVIRUS_ECHEC_FERME=true
ANTIVIRUS_AUTORISER_AUCUN=false
# Memoire du conteneur clamav : 3g minimum conseille (la base de signatures est chargee en memoire).
CLAMAV_MEM_LIMIT=3g
