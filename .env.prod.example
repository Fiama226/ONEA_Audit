# PRODUCTION environment file. Copy to .env.prod (git-ignored) and replace EVERY CHANGE_ME.
# Use URL-safe secrets (no @ : / ? # %), e.g.  openssl rand -hex 32
#   docker compose --env-file .env.prod -f docker/compose.prod.yml config
# Placeholders only - no real secret belongs in this file. See docs/deploy.md.

# --- Public host names (DNS must point to this server; the TLS certificate must cover both) ---
PUBLIC_HOST=audit.example.org
SSO_HOST=sso.example.org
# Host directory holding fullchain.pem and privkey.pem (mounted read-only into nginx)
TLS_CERT_DIR=/etc/onea/certs
# Addresses (comma-separated IPs/CIDRs) allowed to open the Keycloak admin console and the
# master realm through nginx. Empty = nobody (use an SSH tunnel instead, see docs/deploy.md).
ADMIN_ALLOW_CIDR=
# Only if the SSO certificate is signed by an internal CA: path INSIDE the container of a PEM
# bundle placed in ./certs/ (e.g. /etc/onea/ca/ca-bundle.pem). Empty = default trust store.
SSO_CA_BUNDLE_PATH=

# --- Release: tag of the application images (onea-backend / onea-frontend) ---
APP_VERSION=1.0.0

# --- Django ---
SECRET_KEY=CHANGE_ME_django_secret_key_at_least_50_random_characters
# Django /admin/ stays off unless set to true
DJANGO_ADMIN_ENABLED=false
# Outgoing mail (SMTP relay of the organisation)
# smtp+tls:// = STARTTLS (587), smtps:// = implicit TLS (465), smtp:// = plain (internal relay)
EMAIL_URL=smtp+tls://CHANGE_ME_user:CHANGE_ME_password@smtp.example.org:587

# --- PostgreSQL (application) ---
POSTGRES_DB=onea
POSTGRES_USER=onea
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Redis/Valkey (password-protected; it is embedded in REDIS_URL, so keep it URL-safe:
#     letters and numbers only, or percent-encode special characters) ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Keycloak (own PostgreSQL instance) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_password
# Secret of the confidential client onea-backend. Keep the placeholder (any non-empty value)
# until the realm exists (docs/deploy.md section 5.6), then paste the real client secret.
OIDC_RP_CLIENT_SECRET=CHANGE_ME_oidc_backend_client_secret
# Service account onea-admin-sync (view-users + manage-users); same value as in the realm.
KEYCLOAK_ADMIN_API_CLIENT_ID=onea-admin-sync
KEYCLOAK_ADMIN_API_CLIENT_SECRET=CHANGE_ME_keycloak_admin_sync_secret

# --- Meilisearch ---
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key_at_least_16_bytes

# --- Documents (fichiers générés) : disque du serveur, voir docs/stockage-fichiers.md ---
# Dossier de l'hôte monté dans web et worker (créé par : install -d -o 10001 -g 10001 -m 0750 ...).
DOCUMENTS_HOST_DIR=/srv/onea/documents

# --- Optional tuning ---
# COMPOSE_PROJECT_NAME=onea-prod
# WEB_CONCURRENCY=3
