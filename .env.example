# Copy to .env (`cp .env.example .env`). Compose, the Makefile and scripts/*.sh read it.
# Values below are DEVELOPMENT ONLY - never reuse in production.
# Secrets are required by docker/compose.yml (no built-in defaults).

# --- PostgreSQL ---
POSTGRES_DB=onea
POSTGRES_USER=onea
POSTGRES_PASSWORD=onea-dev-password
DATABASE_URL=postgres://onea:onea-dev-password@localhost:5432/onea

# --- Redis (Valkey) ---
REDIS_URL=redis://localhost:6379/0

# --- Keycloak / OIDC (dev realm "onea", see docker/keycloak/realm-onea.json) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
OIDC_RP_CLIENT_ID=onea-backend
OIDC_RP_CLIENT_SECRET=onea-dev-secret
KEYCLOAK_ADMIN_API_CLIENT_ID=onea-admin-sync
# DEV-ONLY secret of the onea-admin-sync service account (refused by the prod settings).
KEYCLOAK_ADMIN_API_CLIENT_SECRET=onea-dev-sync-secret
OIDC_OP_BASE_URL=http://localhost:8080/realms/onea
# DEV-ONLY public client "onea-dev-cli": the only client with direct access
# (password) grants, meant for curl token checks, e.g.
#   curl -d grant_type=password -d client_id=onea-dev-cli -d username=rai \
#        -d password=onea2026 -d scope=openid $OIDC_OP_BASE_URL/protocol/openid-connect/token
# onea-frontend / onea-backend use the authorization code flow only.

# --- Documents (fichiers générés) ---
# Dev : dossier local hors suivi de version (.dev/). Jamais de fichiers dans le dépôt.
DOCUMENTS_STORAGE=filesystem
# DOCUMENTS_ROOT=  (défaut : <dépôt>/.dev/documents ; chemin absolu si renseigné)
# DOCUMENTS_ESPACE_MIN_LIBRE_MO=1024
# DOCUMENTS_QUOTA_MO=0
# DOCUMENTS_MAX_GABARIT_MO=10
# DOCUMENTS_PDFA=true
# Bascule S3 compatible (DOCUMENTS_STORAGE=s3) : les quatre variables sont requises.
# DOCUMENTS_S3_BUCKET=
# DOCUMENTS_S3_ENDPOINT_URL=
# DOCUMENTS_S3_ACCESS_KEY=
# DOCUMENTS_S3_SECRET_KEY=

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=onea-meili-master-key-dev

# --- Gotenberg (docx -> PDF) ---
GOTENBERG_URL=http://localhost:3000

# --- Mail (Mailpit in dev; UI on http://localhost:8025) ---
# Use smtp://localhost:1025 when the backend runs on the host,
# smtp://mailpit:1025 when it runs inside the compose network.
EMAIL_URL=smtp://mailpit:1025

# --- Host port overrides (only if the default is already taken on your machine) ---
# When changing one, also update the matching URL above.
# COMPOSE_PROJECT_NAME=onea
# DB_PORT=5432
# REDIS_PORT=6379
# KEYCLOAK_PORT=8080
# MEILI_PORT=7700
# GOTENBERG_PORT=3000
# MAILPIT_SMTP_PORT=1025
# MAILPIT_HTTP_PORT=8025
# NGINX_PORT=8081

# Pièces justificatives (lot 6) : répertoire sur le disque du serveur, hors dépôt (défaut : var/fichiers)
# FICHIERS_RACINE=var/fichiers
# STOCKAGE_PREUVES_BACKEND=apps.accomplissement.stockage.StockageDisque

# --- Relances du suivi (lot 8) ---
# Base des liens des e-mails ; https:// obligatoire en production.
PLATEFORME_URL=http://localhost:5173
# RELANCES_ACTIVES=true
# RELANCES_MAX_EMAILS_PAR_EXECUTION=200
