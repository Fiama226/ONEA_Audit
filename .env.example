# Copy to .env and adjust. Values below are DEVELOPMENT ONLY - never reuse in production.

# --- PostgreSQL ---
POSTGRES_DB=onea
POSTGRES_USER=onea
POSTGRES_PASSWORD=onea
DATABASE_URL=postgres://onea:onea@localhost:5432/onea

# --- Redis (Valkey) ---
REDIS_URL=redis://localhost:6379/0

# --- Keycloak / OIDC ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_RP_CLIENT_ID=onea-backend
OIDC_RP_CLIENT_SECRET=onea-dev-secret
OIDC_OP_BASE_URL=http://localhost:8080/realms/onea

# --- MinIO (S3) ---
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=onea-minio
MINIO_SECRET_KEY=onea-minio-secret
MINIO_BUCKET=onea-documents

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=onea-meili-master-key

# --- Gotenberg (docx -> PDF) ---
GOTENBERG_URL=http://localhost:3000

# --- Mail (Mailpit in dev; UI on http://localhost:8025) ---
# Use smtp://localhost:1025 when the backend runs on the host,
# smtp://mailpit:1025 when it runs inside the compose network.
EMAIL_URL=smtp://mailpit:1025

# --- Host port overrides (only if the default is already taken on your machine) ---
# When changing one, also update the matching URL above.
# COMPOSE_PROJECT_NAME=onea
# DB_PORT=5432
# REDIS_PORT=6379
# KEYCLOAK_PORT=8080
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MEILI_PORT=7700
# GOTENBERG_PORT=3000
# MAILPIT_SMTP_PORT=1025
# MAILPIT_HTTP_PORT=8025
# NGINX_PORT=8081

# --- MinIO images (upstream minio/minio is no longer published; default is the pgsty AGPL fork) ---
# MINIO_IMAGE=pgsty/minio
# MINIO_MC_IMAGE=pgsty/mc
